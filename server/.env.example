# Server
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/gratiwall
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS: comma-separated origins allowed to call the API / open sockets.
# Local dev needs only the Vite origin. In production (Render), set this to
# the Vercel frontend URL, e.g. CLIENT_URL=https://gratiwall.vercel.app
CLIENT_URL=http://localhost:5173

# Email (optional). If SMTP_HOST is not set, notification emails are
# printed to the server console instead of being sent, so the app never
# crashes because of missing SMTP configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GratiWall <no-reply@gratiwall.edu>
