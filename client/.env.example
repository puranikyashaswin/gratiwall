# Client build-time configuration (Vite embeds this at build time).
#
# Leave unset for local development: requests stay relative and the Vite
# dev server proxies /api and /socket.io to the backend on port 5001.
#
# For the production build (Vercel), set this to the deployed backend URL
# with no trailing slash, e.g. the Render service:
# VITE_API_URL=https://gratiwall-api.onrender.com
VITE_API_URL=
