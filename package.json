{
  "name": "gratiwall",
  "version": "1.0.0",
  "private": true,
  "description": "GratiWall — Campus Appreciation & Recognition Platform (MERN)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "install-all": "npm install",
    "seed": "npm run seed --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
